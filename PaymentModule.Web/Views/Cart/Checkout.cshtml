@model PaymentModule.Business.Dtos.OutputDtos.UserCartOutputDto
@using PaymentModule.Data.Entities
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAddressId = Context.Session.GetInt32("AddressId") ?? 0;
}

<section class="checkout-page">
    <div class="checkout-container">
        <div class="checkout-left">
            <h2 class="checkout-title">Checkout</h2>

            <!-- Payment Method -->
            <div class="checkout-section">
                <h3>Payment Method</h3>
                <div class="payment-options">
                    <label class="payment-option">
                        <input type="radio" name="payment" value="PayPal" />
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/b5/PayPal.svg" alt="PayPal" class="payment-logo" />
                        <span>PayPal</span>
                    </label>
                    <label class="payment-option">
                        <input type="radio" name="payment" value="COD" checked />
                        <img src="https://cdn-icons-png.flaticon.com/512/1041/1041873.png" alt="COD" class="payment-logo" />
                        <span>Cash on Delivery (COD)</span>
                    </label>
                </div>
            </div>

            <!-- Shipping Address -->
            <div class="checkout-section">
                <h3>Shipping Address</h3>
                <p id="selectedAddressText" style="margin-bottom: 10px; color: #333;">
                    @(ViewBag.AddressDisplay ?? "No address selected.")
                </p>
                <button type="button" class="btn-add-address" id="btnChangeAddress">Change / Add Address</button>
            </div>

            <!-- Coupon -->
            <div class="checkout-section">
                <h3>Discount Code</h3>
                <select id="couponSelect" class="coupon-select" style="padding: 8px; border-radius: 5px;">
                    <option value="">-- Select a discount --</option>
                    <option value="10">10% OFF (demo)</option>
                    <option value="20">20% OFF (demo)</option>
                </select>
                <button type="button" class="btn-apply-coupon" id="btnApplyCoupon">Apply</button>
                <p id="couponMsg" class="coupon-msg"></p>
            </div>

            <!-- Review Items -->
            <div class="checkout-section">
                <h3>Review Items</h3>
                @foreach (var item in Model.Items)
                {
                    <div class="checkout-item">
                        <img src="@item.Images" alt="@item.Title" class="checkout-item-img" />
                        <div class="checkout-item-info">
                            <p class="checkout-item-title">@item.Title</p>
                            <p>Qty: @item.Quantity × $@item.Price.ToString("N2")</p>
                            <p><strong>$@item.TotalPrice.ToString("N2")</strong></p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Order Summary -->
        <div class="checkout-right">
            <div class="order-summary">
                <h4>Order Summary</h4>
                <p>Items: <strong>@Model.Items.Count</strong></p>
                <p>Subtotal: <span id="subtotal" data-value="@Model.TotalPrice">$@Model.TotalPrice.ToString("N2")</span></p>
                <p>Shipping Fee: <span id="shippingCost" data-value="0">Calculating...</span></p>
                <p>Discount: <span id="discountAmount" data-value="0">$0.00</span></p>
                <hr />
                <p><strong>Total: <span id="orderTotal" data-value="@Model.TotalPrice">$@Model.TotalPrice.ToString("N2")</span></strong></p>
                <button type="button" class="btn-confirm-pay" id="btnConfirmPay">Confirm and Pay</button>
            </div>
        </div>
    </div>
</section>

<!-- Change / Add Address Modal -->
<div id="addressModal" class="modal-overlay">
    <div class="modal-box">
        <h3>Select or Add Address</h3>
        <div id="addressList" class="address-list"><p>Loading addresses...</p></div>
        <hr />
        <h4>Add New Address</h4>
        <form id="addressForm">
            <input type="text" name="FullName" placeholder="Full Name" required />
            <input type="text" name="Street" placeholder="Street" required />
            <input type="text" name="City" placeholder="City" required />
            <input type="text" name="State" placeholder="State" />
            <input type="text" name="Country" placeholder="Country" required />
            <input type="text" name="Phone" placeholder="Phone" required />
            <button type="submit" class="btn-save">Save Address</button>
        </form>
        <div class="modal-actions">
            <button type="button" class="btn-cancel" id="closeModal">Close</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById("addressModal");
        const btnChange = document.getElementById("btnChangeAddress");
        const closeBtn = document.getElementById("closeModal");
        const listContainer = document.getElementById("addressList");
        const form = document.getElementById("addressForm");
        const selectedText = document.getElementById("selectedAddressText");
        const subtotalEl = document.getElementById("subtotal");
        const shippingEl = document.getElementById("shippingCost");
        const discountEl = document.getElementById("discountAmount");
        const totalEl = document.getElementById("orderTotal");
        const confirmBtn = document.getElementById("btnConfirmPay");
        const currentAddressId = parseInt('@currentAddressId') || 0;

        // ==== USD formatter ====
        function formatCurrency(num) {
            const n = parseFloat(num) || 0;
            return n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        }

        // ==== Update summary ====
        function updateSummary() {
            const subtotal = parseFloat(subtotalEl.dataset.value) || 0;
            const shipping = parseFloat(shippingEl.dataset.value) || 0;
            const discount = parseFloat(discountEl.dataset.value) || 0;
            const total = subtotal + shipping - discount;

            shippingEl.textContent = formatCurrency(shipping);
            discountEl.textContent = formatCurrency(discount);
            totalEl.textContent = formatCurrency(total);
            confirmBtn.textContent = `Confirm and Pay (${formatCurrency(total)})`;
        }

        // ==== Fetch shipping fee ====
        async function fetchShippingFee(addressId) {
            if (!addressId) return;
            shippingEl.textContent = "Calculating...";
            try {
                const res = await fetch(`/cart/api/calculate-shipping?addressId=${addressId}`);
                if (!res.ok) throw new Error("API error");
                const data = await res.json();
                shippingEl.dataset.value = data.fee || 0;
            } catch (err) {
                console.error("Shipping fee error:", err);
                shippingEl.dataset.value = 2.00;
            }
            updateSummary();
        }

        // ==== Load addresses (popup) ====
        async function loadAddresses() {
            listContainer.innerHTML = "<p>Loading...</p>";
            const res = await fetch("/order/GetAddresses");
            const data = await res.json();

            if (!data.length) {
                listContainer.innerHTML = "<p>No address found. Please add a new one below.</p>";
                return;
            }

            listContainer.innerHTML = "";
            data.forEach(a => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "btn-address-option";
                btn.textContent = `${a.fullName} — ${a.street}, ${a.city}, ${a.country}`;
                btn.onclick = () => selectAddress(a);
                listContainer.appendChild(btn);
            });
        }

        // ==== Select address ====
        async function selectAddress(addr) {
            const res = await fetch("/order/ChangeAddress", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(addr.id)
            });
            if (res.ok) {
                selectedText.textContent = `${addr.fullName}, ${addr.street}, ${addr.city}, ${addr.country}`;
                modal.classList.remove("show");
                await fetchShippingFee(addr.id);
            } else {
                alert("❌ Failed to change address.");
            }
        }

        // ==== Add new address ====
        form.addEventListener("submit", async e => {
            e.preventDefault();
            const data = Object.fromEntries(new FormData(form).entries());
            const res = await fetch("/order/SaveAddress", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                alert("✅ New address added!");
                form.reset();
                await loadAddresses();
            } else {
                alert("❌ Failed to add address.");
            }
        });

        // ==== Coupon logic (fixed) ====
        const couponSelect = document.getElementById("couponSelect");
        const applyBtn = document.getElementById("btnApplyCoupon");
        const msg = document.getElementById("couponMsg");

        applyBtn.addEventListener("click", () => {
            const coupon = couponSelect.value;
            const subtotal = parseFloat(subtotalEl.dataset.value);
            let discount = 0;

            if (!coupon) {
                msg.textContent = "❌ Please select a discount code!";
                msg.style.color = "red";
                return;
            }

            if (coupon === "10") {
                discount = subtotal * 0.1;
                msg.textContent = "✔️ 10% discount applied!";
            } else if (coupon === "20") {
                discount = subtotal * 0.2;
                msg.textContent = "✔️ 20% discount applied!";
            } else {
                msg.textContent = "❌ Invalid code!";
                msg.style.color = "red";
                return;
            }

            discountEl.dataset.value = discount;
            msg.style.color = "#0654ba";
            updateSummary();
        });
        // ==== Confirm and Pay (fixed) ====
confirmBtn.addEventListener("click", async () => {
    const subtotal = parseFloat(subtotalEl.dataset.value) || 0;
    const shipping = parseFloat(shippingEl.dataset.value) || 0;
    const discount = parseFloat(discountEl.dataset.value) || 0;
    const total = subtotal + shipping - discount;
    const coupon = document.getElementById("couponSelect").value;
    const paymentMethod = document.querySelector('input[name="payment"]:checked').value;

    if (!selectedText.textContent || selectedText.textContent === "No address selected.") {
        alert("⚠️ Please select a shipping address before proceeding.");
        return;
    }

    // Fetch current address ID (from session or popup)
    const response = await fetch("/order/GetAddresses");
    const addresses = await response.json();
    const matched = addresses.find(a => selectedText.textContent.includes(a.street));
    const addressId = matched ? matched.id : 0;

    const payload = {
        subtotal,
        shipping,
        discount,
        total,
        coupon,
        paymentMethod,
        addressId,
        address: {
            fullName: selectedText.textContent.split(",")[0] || "Unknown",
            street: selectedText.textContent,
            cityLine: "",
            country: "",
            phone: ""
        }
    };

    try {
        const res = await fetch("/order/ConfirmFromCheckout", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            window.location.href = "/order/confirm";
        } else {
            alert("❌ Failed to confirm payment. Please try again.");
        }
    } catch (err) {
        console.error("Payment confirm error:", err);
        alert("⚠️ Something went wrong. Please try again later.");
    }
});

        // ==== Popup logic ====
        btnChange.addEventListener("click", () => {
            modal.classList.add("show");
            loadAddresses();
        });
        closeBtn.addEventListener("click", () => modal.classList.remove("show"));
        window.addEventListener("click", e => { if (e.target === modal) modal.classList.remove("show"); });

        // ==== Init ====
        if (currentAddressId) fetchShippingFee(currentAddressId);
        else updateSummary();
    });
</script>

<style>
    .checkout-container {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin: 40px auto;
        max-width: 1000px;
    }

    .checkout-left {
        flex: 2;
    }

    .checkout-right {
        flex: 1;
        background: #fafafa;
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #ddd;
    }

    .checkout-section {
        margin-bottom: 20px;
    }

    .checkout-item {
        display: flex;
        gap: 15px;
        border-bottom: 1px solid #eee;
        padding: 10px 0;
    }

    .checkout-item-img {
        width: 70px;
        height: 70px;
        border-radius: 10px;
        object-fit: cover;
    }

    .payment-option {
        display: flex;
        align-items: center;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        margin-bottom: 8px;
        cursor: pointer;
    }

        .payment-option input {
            margin-right: 10px;
        }

    .btn-apply-coupon, .btn-confirm-pay {
        background: #0064d2;
        color: #fff;
        border: none;
        padding: 10px 18px;
        border-radius: 30px;
        cursor: pointer;
        font-weight: 600;
        pointer-events: auto;
    }

        .btn-apply-coupon:hover, .btn-confirm-pay:hover {
            background: #0654ba;
        }

    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: white;
        padding: 20px;
        border-radius: 10px;
        width: 400px;
        max-height: 90vh;
        overflow: auto;
    }

        .modal-box input {
            width: 100%;
            padding: 8px;
            margin: 4px 0;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

    .btn-address-option {
        display: block;
        width: 100%;
        text-align: left;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 8px;
        margin-bottom: 8px;
        background: #fff;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-address-option:hover {
            background: #e9f2ff;
            border-color: #0064d2;
        }

    .btn-cancel, .btn-save {
        padding: 8px 16px;
        border-radius: 20px;
        border: none;
        cursor: pointer;
    }

    .btn-cancel {
        background: #eee;
    }

    .btn-save {
        background: #0064d2;
        color: white;
        margin-top: 10px;
    }
</style>
