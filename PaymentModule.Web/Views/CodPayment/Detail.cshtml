@model PaymentModule.Data.Entities.OrderTable

@{
    ViewData["Title"] = "COD Order Details";
}

<div class="cod-detail-wrapper py-5">
    <div class="card shadow-lg border-0 rounded-4 col-lg-10 mx-auto">
        <div class="card-header bg-gradient bg-primary text-white text-center py-4 rounded-top-4">
            <h2 class="mb-0 fw-bold text-uppercase"><i class="bi bi-receipt-cutoff me-2"></i>@ViewData["Title"]</h2>
        </div>

        <div class="card-body p-4 bg-white">
            @if (Model != null)
            {
                <!-- Order Information -->
                <div class="section mb-4">
                    <h5 class="section-title"><i class="bi bi-box-seam me-2 text-primary"></i>Order Information</h5>
                    <hr />
                    <div class="row g-4">
                        <div class="col-md-6">
                            <p><strong>Order ID:</strong> <span class="text-primary">#@Model.Id</span></p>
                            <p><strong>Order Date:</strong> @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>
                            <p>
                                <strong>Status:</strong>
                                <span class="badge fs-6
                                    @(Model.Status == "Pending" ? "bg-warning text-dark" :
                                    Model.Status == "Confirmed" ? "bg-info text-dark" :
                                    Model.Status == "Delivered" ? "bg-success" :
                                    Model.Status == "Completed" ? "bg-dark" : "bg-secondary")">
                                    @Model.Status
                                </span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Buyer:</strong> @Model.Buyer?.Username</p>
                            <p><strong>Email:</strong> @Model.Buyer?.Email</p>
                        </div>
                    </div>
                </div>

                <!-- Shipping Address -->
                @if (Model.Address != null)
                {
                    <div class="section mb-4">
                        <h5 class="section-title"><i class="bi bi-geo-alt me-2 text-danger"></i>Shipping Address</h5>
                        <hr />
                        <p><strong>Recipient:</strong> @Model.Address.FullName</p>
                        <p><strong>Phone:</strong> @Model.Address.Phone</p>
                        <p><strong>Address:</strong> @Model.Address.Street, @Model.Address.City, @Model.Address.State, @Model.Address.Country</p>
                    </div>
                }

                <!-- Payment Information -->
                <div class="section mb-4">
                    <h5 class="section-title"><i class="bi bi-cash-stack me-2 text-warning"></i>Payment Information</h5>
                    <hr />
                    @{
                        var payment = Model.Payments?.FirstOrDefault();
                    }
                    @if (payment != null)
                    {
                        <div class="row">
                            <div class="col-md-4">
                                <p><strong>Method:</strong> <span class="badge bg-warning text-dark">@payment.Method</span></p>
                            </div>
                            <div class="col-md-4">
                                <p>
                                    <strong>Status:</strong>
                                    <span class="badge @(payment.Status == "Paid" ? "bg-success" : "bg-secondary")">@payment.Status</span>
                                </p>
                            </div>
                            <div class="col-md-4">
                                <p>
                                    <strong>Paid At:</strong>
                                    @(payment.PaidAt.HasValue ? payment.PaidAt.Value.ToString("dd/MM/yyyy HH:mm") : Html.Raw("<span class='text-muted'>Unpaid</span>"))
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No payment information available.</p>
                    }
                </div>

                <!-- Product List -->
                <div class="section mb-4">
                    <h5 class="section-title"><i class="bi bi-bag-check me-2 text-success"></i>Product List</h5>
                    <hr />
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered align-middle mb-0">
                            <thead class="table-primary text-center">
                                <tr>
                                    <th>Product Name</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderItems != null && Model.OrderItems.Any())
                                {
                                    foreach (var item in Model.OrderItems)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@item.Product?.Title</strong><br />
                                                <small class="text-muted">@item.Product?.Description?.Substring(0, Math.Min(80, item.Product.Description.Length))...</small>
                                            </td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end text-primary fw-semibold">@item.UnitPrice ₫</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted">No products found.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="2" class="text-end">Total:</th>
                                    <th class="text-end text-danger fs-5">@Model.TotalPrice ₫</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="section text-center">
                    <h5 class="section-title text-secondary mb-3"><i class="bi bi-gear-wide-connected me-2"></i>Actions</h5>
                    <div class="d-flex justify-content-center flex-wrap gap-3 mb-4">
                        <form asp-action="Confirm" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm">
                                <i class="bi bi-check-circle"></i> Confirm Order
                            </button>
                        </form>

                        <form asp-action="Deliver" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-warning btn-lg text-dark shadow-sm">
                                <i class="bi bi-truck"></i> Mark as Delivered
                            </button>
                        </form>

                        <form asp-action="Verify" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="bi bi-cash-coin"></i> Confirm COD Payment
                            </button>
                        </form>
                    </div>

                    <!-- Nút Back -->
                    <a asp-action="Manage" class="btn btn-outline-secondary btn-lg shadow-sm">
                        <i class="bi bi-arrow-left-circle"></i> Back to Order List
                    </a>
                </div>
            }
            else
            {
                <div class="alert alert-danger text-center mt-4">
                    <i class="bi bi-exclamation-triangle"></i> Order not found or you do not have permission to view it.
                </div>
            }
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f5f7fa;
    }

    .cod-detail-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100vh;
    }

    .section {
        background: #fff;
        padding: 1.25rem 1.5rem;
        border-radius: 0.8rem;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .section-title {
        font-weight: 700;
        color: #2b3d8f;
    }

    table {
        border-radius: 0.75rem;
        overflow: hidden;
    }

        table tbody tr:hover {
            background-color: #f0f6ff;
            transition: 0.2s;
        }

    .btn {
        border-radius: 0.75rem;
        padding: 0.65rem 1.25rem;
        transition: all 0.2s ease-in-out;
    }

        .btn:hover {
            transform: scale(1.05);
        }

    .badge {
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        font-size: 0.9rem;
    }
</style>
